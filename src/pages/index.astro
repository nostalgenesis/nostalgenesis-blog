---
import Layout from '../layouts/Layout.astro';

import type { MarkdownInstance } from 'astro';

const posts = Object.values(
  import.meta.glob<MarkdownInstance<{ title: string; date: string }>>(
    './articoli/*.md',
    { eager: true }
  )
).sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);
---
<Layout title="Nostalgenesis · Filologia, Digital Humanities ed eresie varie">

<ul>
  {posts.map((post, i) => (
    <li>
      <time datetime={post.frontmatter.date}>
        {new Date(post.frontmatter.date).toLocaleDateString('it-IT', {
          day: '2-digit',
          month: '2-digit',
          year: '2-digit',
          timeZone: 'UTC',
        })}
      </time>
      <a href={post.url} set:html={post.frontmatter.title}></a>
      {i < posts.length - 1 && <div class="separatore">❦ ❦ ❦ ❦ ❦</div>}
    </li>
  ))}
</ul>

</Layout>

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    margin: 2.5rem 0;
  }

  time {
    color: #777;
    font-size: 0.85rem;
    margin-right: 0.75rem;
  }

  a {
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
  }

  a:hover {
    text-decoration: underline;
  }

  .separatore {
    text-align: center;
    color: #999;
    font-size: 0.8rem;
    margin-top: 2.5rem;
    letter-spacing: 0.3em;
    user-select: none;
  }
</style>