---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, mainClass } = Astro.props;
---
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline src="/script.js"></script>
</head>
<body>
    <Header />

    <main class={mainClass}>
        <slot />
    </main>

    <Footer />

    <div class="text-size-toggle floating-text-size" role="group" aria-label="Ridimensiona il testo">
        <button type="button" class="font-decrease-btn" data-font-action="decrease" aria-label="Rimpicciolisci il testo"><b>A−</b></button>
        <button type="button" class="font-reset-btn" data-font-action="reset" aria-label="Dimensione del testo predefinita">A</button>
        <button type="button" class="font-increase-btn" data-font-action="increase" aria-label="Ingrandisci il testo"><b>A+</b></button>
    </div>
</body>
</html>