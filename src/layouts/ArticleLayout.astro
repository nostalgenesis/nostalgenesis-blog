---
import Layout from './Layout.astro';
import Fleuron from '../components/Fleuron.astro';

const { frontmatter } = Astro.props;
const { title, date, introduzione, bibliografia } = frontmatter;
const d = new Date(date);

const plainTitle = title ? title.replace(/<[^>]*>?/gm, '') : '';
---
<Layout title={`${plainTitle} · Daniel Di Primo`}>
  <article>
    <header>
      <time datetime={d.toISOString().slice(0, 10)}>
        {d.toLocaleDateString('it-IT', { timeZone: 'UTC' })}
      </time>
      <h1 set:html={title} />
    </header>

    {introduzione && (
      <div class="introduzione" set:html ={introduzione} style=" font-style: italic;">
        <p>{introduzione}</p>
      </div>
      <Fleuron />
    )}

    <div class="entry-content">
      <slot />
    </div>
    <Fleuron />
    
    {bibliografia && (
      <>
        <Fleuron />
        <section class="bibliografia">
          <h2>Letture</h2>
          <ul>
            {bibliografia.map((voce: string) => <li set:html={voce} />)}
          </ul>
        </section>
      </>
    )}
  </article>
</Layout>