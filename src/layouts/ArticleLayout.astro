---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
const { title, date, bibliografia } = frontmatter;
const d = new Date(date);

// Rimuove i tag HTML per il titolo della pagina (browser tab)
const plainTitle = title ? title.replace(/<[^>]*>?/gm, '') : '';
---
<Layout title={`${plainTitle} · Daniel Di Primo`}>
  <article>
    <header>
      <time datetime={d.toISOString().slice(0, 10)}>
        {d.toLocaleDateString('it-IT', { timeZone: 'UTC' })}
      </time>
      <h1 set:html={title} />
    </header>

    <hr />
    <slot />
    <hr />

    {bibliografia && (
      <section class="bibliografia">
        <h2>Letture</h2>
        <ul>
          {bibliografia.map((voce: string) => <li set:html={voce} />)}
        </ul>
      </section>
    )}
  </article>
</Layout>