---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
const { title, date, bibliografia } = frontmatter;
const d = new Date(date);
---
<Layout title={`${title} · Daniel Di Primo`}>
  <article>
    <header>
      <time datetime={d.toISOString().slice(0, 10)}>
        {d.toLocaleDateString('it-IT', { timeZone: 'UTC' })}
      </time>
      <h1>{title}</h1>
    </header>

    <hr />
    <slot />
    <hr />

    {bibliografia && (
      <section class="bibliografia">
        <h2>Letture</h2>
        <ul>
          {bibliografia.map((voce: string) => <li set:html={voce} />)}
        </ul>
      </section>
    )}
  </article>
</Layout>

<style is:global>
  article time { font-size: .85rem; color: #777; text-transform: uppercase; letter-spacing: .05em; }
  article h1 { font-size: 1.8rem; line-height: 1.3; margin: .5rem 0 0; }
  article p { margin: 0 0 1.5rem; }
  article blockquote { margin: 2rem 0; padding-left: 1.5rem; border-left: 2px solid #1a1a1a; font-style: italic; color: #333; }
  article img { display: block; max-width: 100%; height: auto; margin: 2rem auto 0; border-radius: 10px; }
  article figure { margin: 2rem 0; }
  article figure img { margin-top: 0; }
  article figcaption { margin-top: .7rem; font-size: .85rem; font-style: italic; color: #666; }

  /* ❦❦❦ : vale sia per quelli del layout sia per i `---` nel markdown */
  article hr { border: 0; text-align: center; margin: 3rem 0; }
  article hr::after { content: "❦ ❦ ❦ ❦ ❦ ❦ ❦"; color: #999; font-size: .85rem; }

  /* note (generate da [^1]) e letture */
  article h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: .05em; }
  .footnotes, .bibliografia { font-size: .95rem; color: #444; }
  .footnotes { border-top: 1px solid #e0e0e0; padding-top: 1.5rem; }
  .footnotes li { margin-bottom: .8rem; }
  .footnotes p { margin: 0; }
  sup a { text-decoration: none; font-weight: bold; color: #777; }
</style>